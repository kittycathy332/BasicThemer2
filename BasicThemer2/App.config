<?xml version="1.0" encoding="utf-8"?>
<configuration>
    <startup>
        <!-- sku 특성을 넣지 않습니다.
             sku=".NETFramework,Version=v4.7.2" 를 요구하면 .NET 4.6.1 까지만
             설치 가능한 Windows Vista 에서 즉시 기동이 거부됩니다.
             단일 빌드는 Vista~11 을 모두 지원해야 하므로 v4.0 만 지정합니다. -->
        <supportedRuntime version="v4.0"/>
    </startup>
  <!-- 고해상도(PerMonitorV2) 선언은 app.config 가 아니라 app.manifest 에 있습니다.
       manifest 는 실행 파일에 임베딩되므로 파일명을 바꾸거나 exe 만 복사해도 유지되고,
       Vista 처럼 이 요소를 모르는 OS 는 무시합니다.
       app.config 의 System.Windows.Forms.ApplicationConfigurationSection 은
       구 런타임에서 '인식할 수 없는 구성 섹션' 오류를 낼 수 있으므로 사용하지 않습니다. -->
</configuration>
